# ==============================================================================
# CivicOS - Root Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or respective subdirectories
# (backend/.env and frontend/.env) to configure runtime options.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Server Security Settings
# ------------------------------------------------------------------------------

# Database Connection URL
# SQLite default for instant zero-configuration local development:
DATABASE_URL=sqlite+aiosqlite:///./civicos.db

# PostgreSQL alternative for production deployments:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicos

# Secret key used for signing JWT authentication tokens (Must be changed in production)
SECRET_KEY=civicos_super_secret_jwt_key_change_in_production

# JWT algorithm standard
ALGORITHM=HS256

# JWT token expiration time in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed origins for Cross-Origin Resource Sharing (CORS), separated by commas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# AI Agent Integration (Google Gemini AI)
# ------------------------------------------------------------------------------

# Google Gemini API key required for live AI agent execution
# If omitted or invalid, the platform gracefully switches to rule-based fallback logic.
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model version (default: gemini-2.5-flash or gemini-3.6-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Frontend Application Settings
# ------------------------------------------------------------------------------

# Base URL pointing to the FastAPI backend service
VITE_API_BASE_URL=http://localhost:8000
