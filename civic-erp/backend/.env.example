# ==============================================================================
# CivicOS Backend Service - Environment Variable Configuration
# ==============================================================================
# Rename or copy this file to '.env' inside the backend/ directory prior to server launch.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Security Configurations
# ------------------------------------------------------------------------------

# Secret key used for signing JWT access tokens (Replace with a secure random key in production)
SECRET_KEY=civicos_super_secret_jwt_key_change_in_production

# Cryptographic algorithm for JWT encoding and decoding
ALGORITHM=HS256

# Access token validity window in minutes (1440 minutes = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed HTTP origin URLs for Cross-Origin Resource Sharing (CORS)
# Multiple origins should be provided as a comma-separated list without quotes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Driver & Storage URI
# ------------------------------------------------------------------------------

# Default Async SQLite driver (Zero external setup required for local development):
DATABASE_URL=sqlite+aiosqlite:///./civicos.db

# Alternative Async PostgreSQL database driver for production scaling:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicos

# ------------------------------------------------------------------------------
# Artificial Intelligence Agents (Google Gemini SDK Integration)
# ------------------------------------------------------------------------------

# Google Gemini API key used by the 5 specialized AI agents (Priority, Routing,
# Duplicate Detection, Analytics, and Citizen Chatbot).
# Note: If this variable is absent or an invalid key is supplied, the agent layer
# automatically activates deterministic rule-based fallbacks to prevent service disruption.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier to utilize for content generation
# Supported options: gemini-2.5-flash, gemini-3.6-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
