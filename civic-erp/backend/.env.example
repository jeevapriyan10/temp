# ============================================
# CivicOS Backend Environment Configuration
# ============================================

# Database URL
# SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./civicos.db
# PostgreSQL 15 format:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicos

# Security & JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173
