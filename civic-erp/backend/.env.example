# CivicOS Environment Variables Configuration

# Server & Security
SECRET_KEY=civicos_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./civicos.db
# For PostgreSQL 15:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/civicos

# AI Agents Configuration (Optional)
# If no key is provided, the platform automatically uses built-in intelligent rule-based agent fallbacks.
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
