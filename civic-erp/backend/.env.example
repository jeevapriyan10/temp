# CivicOS Environment Variables Configuration

# Server & Security
SECRET_KEY=civicos_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./civicos.db
# For PostgreSQL 15:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/civicos

# AI Agents Configuration
# GEMINI_API_KEY is required for live Gemini AI behavior. If missing/invalid, system gracefully falls back to rule-based logic.
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
